# Backend (NestJS) configuration.
#
# Copy this file to .env and adjust as needed:
#     cp .env.example .env
#
# .env is gitignored and must never be committed. Only this template is.
# Values are read via ConfigService (see src/main.ts); anything set in your
# shell environment overrides what is written here.

# On Vercel there is no .env file, and neither variable below needs setting
# there. See "Deploying to Vercel" in the root README.md.

# Port the API listens on. The frontend expects 3000 by default.
# Ignored in production: Vercel runs the app as a function and routes requests
# to it internally, so the port passed to app.listen() only matters locally.
PORT=3000

# Origin allowed by CORS - the Next.js dev server.
# Only needed for client-side fetches; Server Components don't use CORS.
#
# This matters locally, where the two apps sit on different ports (4200 and
# 3000) and are therefore different origins. On Vercel both services share one
# domain, so browser calls to /api/backend/* are same-origin and no CORS check
# happens at all. Server-side calls go over an internal binding, which does not
# involve CORS either. Leaving this at the local default in production is
# therefore harmless.
FRONTEND_URL=http://localhost:4200
